# ==============================================================================
# OpenSTA Static Timing & Power Analysis Script for FPU_division (SkyWater 130nm)
# Usage: sta script/sta_fpu_division.tcl
# ==============================================================================

# 1. Read the Sky130 library
read_liberty sky130.lib

# 2. Read the synthesized gate-level netlist generated by Yosys
read_verilog script/fpu_division_mapped.v

# 3. Link the top module
link_design FPU_division

# 4. Create clock constraint (100 MHz target, period = 10.0 ns)
create_clock -name clk -period 10.0 [get_ports clk]

# 5. Constrain input and output ports relative to the clock
set_input_delay -clock clk 0 [all_inputs]
set_output_delay -clock clk 0 [all_outputs]

# ------------------------------------------------------------------
# 1. TIMING REPORT (Setup & Critical Path Delay)
# ------------------------------------------------------------------
puts "\n========================================================"
puts "                TIMING REPORT (CRITICAL PATH)          "
puts "========================================================"

# Report checks for worst setup (max delay) critical timing paths
report_checks -path_delay max -digits 4 > analysis/asic/fpu_division_timing.txt

# Report slack summary
report_worst_slack

# ------------------------------------------------------------------
# 2. POWER REPORT
# ------------------------------------------------------------------
puts "\n========================================================"
puts "                POWER CONSUMPTION REPORT               "
puts "========================================================"
report_power > analysis/asic/fpu_division_power.txt

exit
